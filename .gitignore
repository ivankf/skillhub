# 依赖与缓存
node_modules/
.cache/

# Netlify 构建产物（由 netlify.toml 的 command 生成，只含 index.html + assets）
dist/

# 采集服务产出物（由 python run.py 重新生成）
collector/collected.json
collector/collect.log
__pycache__/
*.pyc

# 本地文件
.DS_Store
Thumbs.db
*.log

# 注意：assets/data.js 需要提交——
# 静态站没有后端，数据层必须在仓库里。
# 由 GitHub Actions 每日自动采集并提交，不要手工改。